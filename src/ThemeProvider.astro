---
import { Icon } from "@astrojs/starlight/components";
---

{/* Starlight's own provider, with one change: a reader who has never chosen a theme
    gets `light`, where Starlight would give them their system preference. Starlight
    records the `auto` choice as an empty string under the same key, so storing the
    default there is also what keeps "never chose" apart from "chose auto" on the
    next visit. The component is inlined and sits in the document head, so the theme
    is set before the first paint. */}
<script is:inline>
  window.StarlightThemeProvider = (() => {
    const storage = typeof localStorage === "undefined" ? null : localStorage;

    let storedTheme = storage && storage.getItem("starlight-theme");
    if (storage && storedTheme === null) {
      storedTheme = "light";
      storage.setItem("starlight-theme", storedTheme);
    }

    const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
    const theme = storedTheme === "" ? (prefersLight ? "light" : "dark") : storedTheme || "light";
    document.documentElement.dataset.theme = theme === "dark" ? "dark" : "light";

    return {
      updatePickers(theme = storedTheme || "auto") {
        document.querySelectorAll("starlight-theme-select").forEach((picker) => {
          const select = picker.querySelector("select");
          if (select) select.value = theme;
          /** @type {HTMLTemplateElement | null} */
          const tmpl = document.querySelector(`#theme-icons`);
          const newIcon = tmpl && tmpl.content.querySelector("." + theme);
          if (newIcon) {
            const oldIcon = picker.querySelector("svg.label-icon");
            if (oldIcon) {
              oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
            }
          }
        });
      },
    };
  })();
</script>

<template id="theme-icons">
  <Icon name="sun" class="light" />
  <Icon name="moon" class="dark" />
  <Icon name="laptop" class="auto" />
</template>

<script is:inline>
  // Prevent Private Use Area characters (font-internal glyph shapes, e.g.
  // the U+E000-U+F8FF codepoints used by the written-unit tables) from being
  // copied out of the page. They only render via this site's webfont and are
  // meaningless anywhere else, so strip them from whatever the user copies.
  // Real characters (letters, FVS, MVS, prose) are unaffected.
  function isPuaCodePoint(cp) {
    return (cp >= 0xe000 && cp <= 0xf8ff) || (cp >= 0xf0000 && cp <= 0xffffd) || (cp >= 0x100000 && cp <= 0x10fffd);
  }
  function stripPua(text) {
    let out = "";
    for (const ch of text) {
      if (!isPuaCodePoint(ch.codePointAt(0))) out += ch;
    }
    return out;
  }
  function hasPua(text) {
    for (const ch of text) {
      if (isPuaCodePoint(ch.codePointAt(0))) return true;
    }
    return false;
  }
  function scrubPuaFromCopy(event) {
    const text = window.getSelection()?.toString() ?? "";
    if (!hasPua(text)) return;
    event.preventDefault();
    event.clipboardData?.setData("text/plain", stripPua(text));
  }
  // Dragging selected text (e.g. into another app or a text field) is another
  // way to move text out of the page. Same rule: drop the PUA glyphs from the
  // payload but keep the drag working for the surrounding real text.
  function scrubPuaFromDrag(event) {
    const text = window.getSelection()?.toString() ?? "";
    if (!hasPua(text)) return;
    const dataTransfer = event.dataTransfer;
    if (!dataTransfer) return;
    const clean = stripPua(text);
    dataTransfer.setData("text/plain", clean);
    dataTransfer.setData("text/html", clean);
  }
  document.addEventListener("copy", scrubPuaFromCopy, true);
  document.addEventListener("cut", scrubPuaFromCopy, true);
  document.addEventListener("dragstart", scrubPuaFromDrag, true);
</script>
