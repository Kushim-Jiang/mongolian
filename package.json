{
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "format": "prettier --write . !mongfontbuilder/src/mongfontbuilder/data/*.json !mongfontbuilder/tests/data/*.json"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/starlight": "0.42.5",
    "@astrojs/svelte": "9.0.1",
    "@types/node": "26.6.4",
    "@unicode/unicode-18.0.0": "2.0.7",
    "astro": "7.3.5",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.mdx",
        "options": {
          "printWidth": 10000
        }
      },
      {
        "files": "*.astro",
        "options": {
          "plugins": [
            "prettier-plugin-astro"
          ],
          "parser": "astro",
          "printWidth": 10000
        }
      },
      {
        "files": "*.svelte",
        "options": {
          "plugins": [
            "prettier-plugin-svelte"
          ],
          "parser": "svelte",
          "printWidth": 10000
        }
      }
    ]
  }
}
