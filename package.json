{
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "format": "prettier --write . !mongfontbuilder/src/mongfontbuilder/data/*.json !mongfontbuilder/tests/data/*.json"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/starlight": "0.43.1",
    "@astrojs/svelte": "9.1.6",
    "@types/node": "26.6.6",
    "@unicode/unicode-18.0.0": "2.0.7",
    "astro": "7.4.12",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "postcss-selector-parser": "^6.1.5",
    "undici": "^8.12.4",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.mdx",
        "options": {
          "printWidth": 10000
        }
      },
      {
        "files": "*.astro",
        "options": {
          "plugins": [
            "prettier-plugin-astro"
          ],
          "parser": "astro",
          "printWidth": 10000
        }
      },
      {
        "files": "*.svelte",
        "options": {
          "plugins": [
            "prettier-plugin-svelte"
          ],
          "parser": "svelte",
          "printWidth": 10000
        }
      }
    ]
  }
}
